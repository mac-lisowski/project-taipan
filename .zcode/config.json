{
  "hooks": {
    "enabled": true,
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "exec|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/pre-exec.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "edit|write|notebook_edit|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/pre-write.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit|write|notebook_edit|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/post-write.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "exec|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/post-exec.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/stop-nudge.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "events": {}
  }
}
