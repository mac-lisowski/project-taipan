# Registry of env vars the api app reads. Copy to .env to override.
# Run with: uv run --env-file apps/api/.env api

# Database connection. Used by api.db and by Alembic (alembic/env.py).
# Default matches docker-compose.yaml and needs no override for local dev.
API_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app

# Test databases. Used by apps/api/tests/conftest.py.
# Defaults match docker-compose.yaml. The devcontainer sets these to
# host "db" (see .devcontainer/docker-compose.yml).
API_TEST_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
API_TEST_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app_test
