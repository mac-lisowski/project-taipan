# Registry of env vars the api app reads. Copy to .env to override.
# Run with: uv run --env-file apps/api/.env api

# Server bind for the api and api-dev entries. Defaults bind all
# interfaces on port 8000.
HOST=0.0.0.0
PORT=8000

# Database connection. Used by api.db and by Alembic (alembic/env.py).
# Default matches docker-compose.yaml and needs no override for local dev.
API_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app

# Test databases. Used by apps/api/tests/conftest.py.
# Defaults match docker-compose.yaml. The devcontainer sets these to
# host "db" (see .devcontainer/docker-compose.yml).
API_TEST_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
API_TEST_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app_test

# DEK cache (L2 tier) for field encryption. Sessions live in Postgres,
# not here. Default matches docker-compose.yaml; the devcontainer sets
# host "redis".
API_REDIS_URL=redis://localhost:6379/0

# How long unwrapped DEKs live in the Redis cache. Optional; the
# default matches api.field_crypto. No other new vars are required.
API_DEK_CACHE_TTL=900

# How long the process-local DEK cache lives before falling back to
# Redis. Short TTL bounds staleness after a KMS-side change. Optional.
API_DEK_CACHE_L1_TTL=60

# Self-hosted Infisical instance (secrets + KMS). Default matches
# docker-compose.yaml; the devcontainer sets host "infisical".
API_INFISICAL_URL=http://localhost:8080
# Machine identity token issued by scripts/infisical-bootstrap.sh.
# Empty until the instance is bootstrapped and a token is created.
API_INFISICAL_TOKEN=
# KMS key id from the Infisical KMS project (see docs/infisical.md).
API_INFISICAL_KMS_KEY_ID=

# Circuit breaker on the KMS path. After this many consecutive KMS
# failures the breaker opens and calls fail fast for the cooldown
# window. Optional; defaults match api.field_crypto.
API_KMS_BREAKER_THRESHOLD=3
API_KMS_BREAKER_COOLDOWN=30

# Session lifetime in seconds for the session store. Optional; default is 7 days (604800).
API_SESSION_TTL_SECONDS=604800

# How long a password reset link token stays valid, in seconds.
# Optional; default is 3600 (one hour).
API_RESET_TOKEN_TTL_SECONDS=3600

# Mail delivery. Server side only; the key never reaches the web client.
# Without API_RESEND_API_KEY the app uses the fake adapter: mail is
# captured in memory and nothing leaves the box (local dev default).
# Prod sets the key and uses the Resend adapter. API_MAIL_FROM is the
# From address for prod sends; required when the key is set.
API_RESEND_API_KEY=
API_MAIL_FROM=noreply@localhost
# Svix signing secret for POST /api/email/webhooks/resend (Resend
# dashboard, whsec_ value). Empty rejects every webhook (fail closed).
API_RESEND_WEBHOOK_SECRET=

# Web origin used to build links inside sent mail (e.g. the reset
# link). Optional; default points at the local web dev server.
API_APP_BASE_URL=http://localhost:3000


# LiteLLM gateway for the chat completion stream. Default matches
# docker-compose.yaml; the devcontainer points it at the litellm host.
API_LITELLM_URL=http://localhost:4000
# Gateway key. Server side only; it never reaches the web client.
API_LITELLM_API_KEY=
# Model name handed to the gateway for every completion.
API_CHAT_MODEL=gpt-4o-mini
