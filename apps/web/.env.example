# Server-side only. The browser never sees this value; BFF route
# handlers under src/app/api/ forward to it.
API_INTERNAL_URL=http://localhost:8000

# Browser-facing origin used to rewrite upstream redirects (Location,
# Content-Location). Optional locally; required in production behind a
# TLS-terminating load balancer, where request origin is http.
# PUBLIC_ORIGIN=https://app.example.com

# Directory of markdown docs rendered at /docs. Defaults to the repo
# docs/ dir; the Dockerfile sets /app/docs.
# DOCS_DIR=/app/docs
